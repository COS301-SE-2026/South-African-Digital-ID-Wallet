#
# Build context is the REPO ROOT (needed for pnpm-lock.yml + workspace file).
# From the repo root:
#   docker build -f dockerfile.web \ -t web-flashid:local .
# 
# syntax=docker/dockerfile:1
#
# Build context is the REPO ROOT (needed for pnpm-lock.yml + workspace file).
# From the repo root:
#   docker build -f dockerfile.web \ -t web-flashid:local .

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat git

# ---------- deps ----------
FROM base AS deps
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/package.json

RUN npm pkg delete scripts.postinstall
RUN pnpm install --frozen-lockfile --filter ./web...

# ---------- builder ----------
FROM base AS builder
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/web/node_modules ./web/node_modules
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY web ./web

ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter ./web run build

# API_INTERNAL_URL is read at runtime (App Service Application Setting) by
# next.config.ts's rewrites(), not baked in here — the same image is built
# once and deployed to both dev and prod, differing only by that setting.'

# ---------- runner ----------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

  # Path mirror the monorepo layout because of standalone output tracing
COPY --from=builder /repo/web/public ./web/public
COPY --from=builder --chown=nextjs:nodejs /repo/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/web/.next/static ./web/.next/static

USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "web/server.js"]